DATABASE_URL=sqlite:///runtime/studio.db
# Live inference is disabled until explicitly enabled.
ALLOW_LIVE_API=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional USD per million tokens. Missing rates mean cost is unknown.
INPUT_USD_PER_MILLION=
OUTPUT_USD_PER_MILLION=
# Optional: install requirements-tracking.txt to enable local MLflow export.
MLFLOW_TRACKING_URI=
# Required for remote API access; never send provider credentials to the frontend.
STUDIO_API_TOKEN=
# Required only for Docker Compose. Replace before starting.
POSTGRES_PASSWORD=
